# HPI AISC – OpenAI-kompatibel über LiteLLM
LITELLM_BASE_URL=https://api.aisc.hpi.de/
LITELLM_API_KEY=DEIN-KEY
# Alternativ akzeptiert config.py auch OPENAI_API_BASE / OPENAI_API_KEY.

# Modelle. Provider-Präfix openai/ ist Pflicht; ohne Präfix ergänzt config.py es automatisch.
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=openai/octen-embedding-8b

# Bewertendes Modell für judge_antwort.py – bewusst ein anderes als LLM_MODEL,
# weil ein Modell die eigene Ausgabe milder beurteilt.
JUDGE_MODEL=llama-3-3-70b

# Ausweichmodelle. Der Cluster fällt einzelne Modelle zeitweise aus; ohne Kette
# bricht ein längerer Eval-Lauf mittendrin ab.
LLM_FALLBACKS=gemma-4-31b,llama-3-3-70b,ministral-3-14b
JUDGE_FALLBACKS=gemma-4-31b,ministral-3-14b,gpt-oss-120b

# Qdrant, lokaler Container
QDRANT_URL=http://localhost:6333
COLLECTION=mleuv_durchstich

# Korpus. Diese Werte beschreiben den Stand, aus dem der aktuelle Index entstanden ist
# (64 Dokumente / 4.889 Chunks). 05/06/07 sind freigegeben, aber nicht indiziert.
CORPUS_DIR=data/Daten des MLEUV
CORPUS_PREFIXES=01,03,04,08,10,11
MAX_DOCS=200

# Schutz: ingest.py löscht die Collection bei RECREATE=true zu Beginn JEDES Laufs.
# Der Eval-Katalog misst gegen genau diesen Index – deshalb aus.
RECREATE=false

# Gültigkeitsfilter: schließt Dokumente aus, die in korpus_status.yaml als
# abgelöst geführt werden (z. B. GAK-Rahmenplan 2025-2028). Zum Vergleichen abschaltbar.
NUR_AKTUELL=true

TOP_K=5

# Ingestion, Vorgaben aus config.py – nur bei Bedarf setzen
# OCR_ENABLED=false
# CHUNK_TOKENIZER=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBED_BATCH=16
# PARENT_MAX_CHARS=6000
